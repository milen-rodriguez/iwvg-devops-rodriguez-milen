          "raw": "{\n    \"firstName\": \"Ada\",\n    \"familyName\": \"Byron Lovelace\",\n    \"email\": \"ada.lovelace@example.com\",\n    \"identity\": \"ID-0001\",\n    \"address\": \"12 St. James's Square\",\n    \"city\": \"London\",\n    \"province\": \"Greater London\",\n    \"postalCode\": \"SW1Y 4LB\"\n}"
