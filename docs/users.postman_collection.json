    },
    {
      "name": "Get billable users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/user?billable=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns billable users', function () {",
              "    pm.response.to.have.status(200);",
              "    const users = pm.response.json();",
              "    pm.expect(users).to.be.an('array').and.have.lengthOf(4);",
              "    users.forEach(function (user) {",
              "        pm.expect(user.billable).to.eql(true);",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
