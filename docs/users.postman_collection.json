    {
      "name": "Get all users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/user"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns all users', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.be.an('array').and.have.lengthOf(6);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
