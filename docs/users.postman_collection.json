    {
      "name": "Reject admin user deactivation",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n    {\n        \"id\": 1,\n        \"active\": false\n    }\n]"
        },
        "url": "{{baseUrl}}/user"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('does not deactivate an admin user', function () {",
              "    pm.response.to.have.status(409);",
              "    const error = pm.response.json();",
              "    pm.expect(error.error).to.eql('AdminUserDeactivationException');",
              "    pm.expect(error.message).to.eql('Admin user with id 1 cannot be deactivated');",
              "    pm.expect(error.code).to.eql(409);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
