{
  "info": {
    "name": "DevOps Users API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Get billable user",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/user/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const user = pm.response.json();",
              "pm.test('returns a billable inactive user', function () {",
              "    pm.expect(user.billable).to.eql(true);",
              "    pm.expect(user.active).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
